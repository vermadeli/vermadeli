}

/* CASILLAS */

.cell{
  position:relative;
  width:72px;
  height:72px;

  background:#fffdf8;

  border:1px solid #d5c7b5;
  border-radius:12px;

  box-shadow:
    inset 0 1px 0 rgba(255,255,255,.85),
    0 2px 4px rgba(0,0,0,.04);
}

/* NEGRAS */

.black{
  width:72px;
  height:72px;

  background:linear-gradient(145deg,#2f2f2f,#171717);
  border-radius:12px;

  display:flex;
  align-items:center;
  justify-content:center;

  color:#fff;
  font-size:30px;
  font-weight:bold;
}

/* NUMERITOS */

.number{
  position:absolute;
  top:6px;
  left:7px;
  font-size:11px;
  color:#8b7a66;
  font-weight:600;
}

/* INPUTS CUADRÍCULA */

.letter-input{
  width:100%;
  height:100%;

  border:none;
  background:transparent;

  text-align:center;
  text-transform:uppercase;

  font-size:34px;
  font-weight:600;
  color:#2e2a24;
}

.letter-input:focus{
  outline:none;
  background:#fff3c9;
  border-radius:12px;
}

