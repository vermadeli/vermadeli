    const piece=document.createElement("div");

    piece.className="confetti";

    piece.style.left=Math.random()*100+"vw";

    piece.style.background=
      colors[Math.floor(Math.random()*colors.length)];

    piece.style.borderRadius=
      Math.random()>.5 ? "50%" : "2px";

    piece.style.animationDuration=
      (3 + Math.random()*2)+"s";

    piece.style.transform=
      `rotate(${Math.random()*360}deg)`;

    document.body.appendChild(piece);

    setTimeout(()=>{
      piece.remove();
    },5500);

  }
}

  function resetAll(){
  if(confirm("¿Estás seguro de que quieres borrar todo?")){
    Object.keys(values).forEach(key => delete values[key]);
    document.querySelectorAll(".letter-input, .clue-cell input").forEach(input => {
      input.value = "";
      input.classList.remove("ink-blue", "ink-italic");
    });
    celebrationShown = false;
    document.getElementById("celebrationOverlay").style.display = "none";
    // eliminar el guardado específico de este crucigrama
    localStorage.removeItem(STORAGE_KEY);
  }
}

function createGridInput(number,label){

  const wrapper=document.createElement("div");
  wrapper.className="cell";

  const num=document.createElement("div");
  num.className="number";
  num.textContent=number+" "+label;

  const input=document.createElement("input");
input.addEventListener("focus", ()=>{

  document
    .querySelectorAll(".selected-cell")
    .forEach(el =>
      el.classList.remove("selected-cell")
    );

  selectedInput = input;

  input.classList.add("selected-cell");
});
  input.className="letter-input";
  input.maxLength=1;
  input.dataset.number=number;
input.addEventListener("focus", ()=>{

  document
    .querySelectorAll(".selected-cell")
    .forEach(el =>
      el.classList.remove("selected-cell")
    );

  selectedInput = input;

  input.classList.add("selected-cell");
});

 input.addEventListener("input",e=>{
    values[number]=e.target.value.toUpperCase();
    sync(number);

     // Avanzar automáticamente al siguiente input
  if(e.target.value){
    const nextInput = document.querySelector(
      `input[data-number="${number + 1}"]`
    );
    if(nextInput) nextInput.focus();
  }
    
});

input.addEventListener("keydown", e=>{
  if(e.key === "Backspace"){
     e.preventDefault();
    values[number] = "";
    e.target.value = "";
    sync(number);
    
    // Retroceder al input anterior
    const prevInput = document.querySelector(
      `input[data-number="${number - 1}"]`
    );
    if(prevInput) prevInput.focus();
  }
});

  wrapper.appendChild(num);
  wrapper.appendChild(input);

  return wrapper;
}

const grid=document.getElementById("grid");

gridCells.forEach(cell=>{
  if(cell===null || (Array.isArray(cell) && cell[0]===null)){
    const black=document.createElement("div");
    black.className="black";
    if(Array.isArray(cell) && cell[1]){
      black.textContent = cell[1];
    }
    grid.appendChild(black);
  } else {
    grid.appendChild(createGridInput(cell[0],cell[1]));
  }
});


const clues=document.getElementById("clues");

clueData.forEach(clue=>{

  const row=document.createElement("div");
  row.className="clue";

  const label=document.createElement("div");
  label.className="clue-label";
  label.textContent=clue.letter + ". " + clue.text;

  const hintBtn=document.createElement("button");
  hintBtn.className="hint-btn";
  hintBtn.textContent="Pista";
hintBtn.onclick=()=>showHint(clue.hint, clue.hintColor);

  const answer=document.createElement("div");
  answer.className="clue-answer";

  clue.cells.forEach((number,index)=>{

    const wrap=document.createElement("div");
    wrap.className="clue-cell";

    const input=document.createElement("input");
    input.maxLength=1;
    input.dataset.number=number;

    input.addEventListener("input",e=>{

      const val=e.target.value.toUpperCase();
      values[number]=val;
      sync(number);

      if(val && index < clue.cells.length-1){
        answer.children[index+1].querySelector("input").focus();
      }

    });

    input.addEventListener("keydown",e=>{
      if(e.key==="Backspace"){
        e.preventDefault();
        values[number]="";
        e.target.value="";
        sync(number);
        
        if(index>0){
          answer.children[index-1].querySelector("input").focus();
        }
      }
    });

    const num=document.createElement("div");
    num.className="clue-number";
    num.textContent=number;

    wrap.appendChild(input);
    wrap.appendChild(num);

    answer.appendChild(wrap);

  });

  row.appendChild(label);
  row.appendChild(hintBtn);
  row.appendChild(answer);

  clues.appendChild(row);

});

window.addEventListener("load", ()=>{
  const saved = localStorage.getItem("Latido_mermado_7");
  if(saved){
    const data = JSON.parse(saved);
    Object.assign(values, data);
    document.querySelectorAll("[data-number]").forEach(el => {
      if(values[el.dataset.number]){
        el.value = values[el.dataset.number];
      }
    });
    checkFinished();
  }
});

window.addEventListener("beforeunload", ()=>{
  localStorage.setItem("Latido_mermado_7", JSON.stringify(values));
});

  function loadSaved(){
  try{
    const saved = JSON.parse(localStorage.getItem(STORAGE_KEY) || '{}');
    // merge en values
    Object.assign(values, saved);
    // rellenar los inputs ya existentes
    Object.keys(values).forEach(n => {
      // sólo sincroniza si hay inputs en DOM
      if(document.querySelector(`[data-number="${n}"]`)){
        sync(n);
      }
    });
  }catch(e){
    console.warn('No se pudo recuperar guardado:', e);
  }
}

  // Intento seguro: carga al finalizar la carga de la página.
// Si la cuadrícula se genera dinámicamente más tarde, asegúrate de
// llamar loadSaved() justo después de crear los inputs.
loadSaved();
window.addEventListener('load', loadSaved);
  
