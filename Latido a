.clue{
  max-width:1120px;

  margin:14px auto;
  padding:18px 22px;

  background:rgba(255,255,255,.78);
  backdrop-filter:blur(8px);

  border:1px solid rgba(170,150,120,.22);
  border-radius:18px;

  box-shadow:
    0 8px 22px rgba(0,0,0,.06);
