}

.hint-close{
  position:absolute;
  top:14px;
  right:18px;

  border:none;
  background:none;

  font-size:28px;
  cursor:pointer;
}


/* ===== CELEBRACIÓN ===== */

#celebrationOverlay{
  position:fixed;
  inset:0;

  display:none;
  align-items:center;
  justify-content:center;

  overflow:hidden;

  background:
    radial-gradient(circle at top left, rgba(255,0,128,.22), transparent 35%),
    radial-gradient(circle at top right, rgba(255,220,0,.22), transparent 35%),
    radial-gradient(circle at bottom left, rgba(0,190,255,.20), transparent 35%),
    rgba(0,0,0,.58);

  backdrop-filter:blur(6px);

  z-index:9999;
}

#celebrationOverlay::before{
  content:"🌈     🎉     🎺     ✨     🌈     🎊     🎺     ✨";
  position:absolute;
  top:8%;
  left:50%;
  transform:translateX(-50%);
  font-size:56px;
  white-space:nowrap;
  animation:floatParty 4s ease-in-out infinite;
}

#celebrationOverlay::after{
  content:"✨     🎺     🌈     🎉     ✨";
  position:absolute;
  bottom:6%;
  left:50%;
  transform:translateX(-50%);
  font-size:44px;
  opacity:.95;
}

#celebrationBox{
  position:relative;

  width:min(760px, 92vw);

  padding:54px 64px;

  border-radius:30px;

  text-align:center;

  background:
